source-repository head
  type: git
  location: https://github.com/rinn7e/haskell-package

library
  exposed-modules:
      Text.Turndown
      Text.Turndown.Dom
      Text.Turndown.Whitespace
  other-modules:
      Paths_turndown
  hs-source-dirs:
      src
  default-extensions:
      BlockArguments
      DerivingStrategies
      DuplicateRecordFields
      ImportQualifiedPost
      LambdaCase
      MultiWayIf
      NamedFieldPuns
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -Weverything -Wno-all-missed-specialisations -Wno-implicit-prelude -Wno-inferred-safe-imports -Wno-missed-specialisations -Wno-missing-import-lists -Wno-missing-kind-signatures -Wno-missing-local-signatures -Wno-missing-safe-haskell-mode -Wno-monomorphism-restriction -Wno-prepositive-qualified-module -Wno-missing-role-annotations -Wno-missing-poly-kind-signatures -Wno-safe -Wno-unsafe
  build-depends:
      base >=4.18 && <5
    , containers >=0.6 && <0.8
    , text >=2.0 && <2.2
    , zenacy-html ==2.1.*
  default-language: Haskell2010

test-suite test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Paths_turndown
  hs-source-dirs:
      test
  default-extensions:
      BlockArguments
      DerivingStrategies
      DuplicateRecordFields
      ImportQualifiedPost
      LambdaCase
      MultiWayIf
      NamedFieldPuns
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -Weverything -Wno-all-missed-specialisations -Wno-implicit-prelude -Wno-inferred-safe-imports -Wno-missed-specialisations -Wno-missing-import-lists -Wno-missing-kind-signatures -Wno-missing-local-signatures -Wno-missing-safe-haskell-mode -Wno-monomorphism-restriction -Wno-prepositive-qualified-module -Wno-missing-role-annotations -Wno-missing-poly-kind-signatures -Wno-safe -Wno-unsafe
  build-depends:
      base >=4.18 && <5
    , directory ==1.3.*
    , filepath >=1.4 && <1.6
    , tasty >=1.4 && <1.6
    , tasty-hunit ==0.10.*
    , text >=2.0 && <2.2
    , turndown
  default-language: Haskell2010
